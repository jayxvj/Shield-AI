# ==============================================================================
# Shield-AI v2 Environment Configuration
# ==============================================================================

# Application
APP_NAME="Shield-AI Threat Detection System"
APP_VERSION="2.0.0"
DEBUG=False

# Database (Use Supabase or Neon PostgreSQL in production, SQLite in local dev)
DATABASE_URL=sqlite:///./security_threats.db
# Example PostgreSQL URL:
# DATABASE_URL=postgresql+psycopg2://postgres:password@db.supabase.co:5432/postgres

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS_STR="http://localhost:3000,http://localhost:8000,https://your-frontend.vercel.app"

# Security
SECRET_KEY="replace-this-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==============================================================================
# AWS S3 Malicious Activity Archival Configuration
# ==============================================================================
S3_BUCKET="shield-ai-threat-archive"
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_REGION="us-east-1"

# Local fallback directory when AWS credentials are not provided
S3_LOCAL_FALLBACK_DIR="./s3_archive"

# ==============================================================================
# Sensor Ingestion Authentication
# ==============================================================================
SENSOR_API_KEY="shield-sensor-secret-key"
